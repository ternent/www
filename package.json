{
  "name": "ternentdotdev",
  "version": "0.0.21",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "vite-ssg build && node scripts/verify-dist.mjs",
    "preview": "vp preview --host 127.0.0.1",
    "fmt": "vp fmt .",
    "fmt:check": "vp fmt --check .",
    "lint": "vp lint src scripts --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:runtime",
    "test:unit": "vp test run",
    "test:unit:watch": "vp test",
    "test:e2e": "playwright test",
    "test:runtime": "vp test run --config vitest.playground.config.ts",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ternent/armour": "0.3.0-alpha.1",
    "@ternent/concord": "0.3.0-alpha.1",
    "@ternent/identity": "0.6.0-alpha.1",
    "@ternent/ledger": "0.2.0-alpha.1",
    "@ternent/seal": "0.5.0-alpha.1",
    "@vueuse/core": "15.0.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "2.6.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-plugin-pwa": "2.0.0",
    "vite-plus": "1.7.0",
    "vite-ssg": "28.3.0",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "workbox-window": "7.4.1"
  },
  "engines": {
    "node": "^26.13.1"
  },
  "packageManager": "pnpm@12.21.0"
}
